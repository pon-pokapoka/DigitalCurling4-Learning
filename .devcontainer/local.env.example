# Personal dev container options. Copy to .devcontainer/local.env (not
# committed) and edit; .devcontainer/dev.sh reads it. Everything is off by
# default, so the container works without an SSH key, GitHub or Claude.
#
# Only dev.sh reads this file. VS Code "Reopen in Container" gets the plain
# container (it reads DC4_CLAUDE_CODE from the environment VS Code starts from,
# and forwards your ssh-agent by itself) and no personal volumes.

# Forward the host ssh-agent into the container (git over SSH, commit
# signing). The private key stays on the host, but any process in the
# container can use the agent while the container runs.
# After changing this: .devcontainer/dev.sh down && .devcontainer/dev.sh up
DC4_SSH_AGENT=0

# Install Claude Code in the image and keep its login and settings in the
# dc4-learning-claude volume. After changing this: .devcontainer/dev.sh rebuild
DC4_CLAUDE_CODE=0

# Keep the GitHub CLI (gh) login in the dc4-learning-gh volume.
# After changing this: .devcontainer/dev.sh down && .devcontainer/dev.sh up
DC4_GITHUB=0

# Keep your git config (name, email, signing setup) in the dc4-learning-git volume,
# so it survives container rebuilds and stays out of the repo. Without it, git
# uses ~/.gitconfig inside the container, which is lost when it is recreated.
# After changing this: .devcontainer/dev.sh down && .devcontainer/dev.sh up
DC4_GIT_CONFIG=0

# Public certificate of a private CA, as a path on the host, for connecting to
# a TLS server that needs it. Leave unset otherwise: nothing is mounted and
# setup-ca.sh does not run. Never point this at a private key.
# After changing this: .devcontainer/dev.sh down && .devcontainer/dev.sh up
#DC4_CA_CERT=/etc/ssl/certs/my-root-ca.pem
# VS Code "Reopen in Container" does not read this file; for it, copy the public
# certificate to .devcontainer/ca.crt instead (not committed), then restart the
# container or run .devcontainer/setup-ca.sh in it.

# Commit signing with your GitHub-registered SSH signing key needs
# DC4_SSH_AGENT=1 and DC4_GIT_CONFIG=1; then run
# .devcontainer/setup-signing.sh once in the container.
