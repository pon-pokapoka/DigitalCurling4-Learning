# Local settings. Copy to .env (not committed) at the repo root. Variables already set
# in the environment win.

# DigitalCurling4 server, for dc4learning.api and the notebooks
DC_SERVER_URL=https://server.example

# python -m dc4learning.selfplay
SELFPLAY_IMAGE=cnn-client:<tag>
SELFPLAY_NAMESPACE=<namespace>
# Server URL as seen from the pods
SELFPLAY_SERVER_URL=http://<server-service>.<server-namespace>.svc.cluster.local:<port>
# Secrets in the namespace with keys auth-id and auth-pw, one login per team
SELFPLAY_TEAM0_SECRET=<team0-secret>
SELFPLAY_TEAM1_SECRET=<team1-secret>
# Optional: login used to create matches (default: the team-0 Secret)
#SELFPLAY_CREATOR_SECRET=
# Optional: RuntimeClass of the GPU pods (default: nvidia; empty to omit)
#SELFPLAY_RUNTIME_CLASS=nvidia
